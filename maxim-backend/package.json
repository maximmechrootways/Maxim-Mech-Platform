{
    "name": "maxim-backend",
    "version": "1.0.0",
    "description": "Frank Cusimano - Maxim Mechanical Backend",
    "main": "dist/index.js",
    "engines": {
        "node": ">=20.0.0"
    },
    "scripts": {
        "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
        "build": "prisma generate && tsc",
        "test": "npm run build && node --test dist/tests/**/*.test.js",
        "start": "node dist/index.js",
        "start:with-migrate": "npm run db:migrate:deploy && node dist/index.js",
        "start:prod": "pm2 start ecosystem.config.js --env production",
        "typecheck": "tsc --noEmit",
        "db:migrate": "prisma migrate dev",
        "db:migrate:deploy": "node scripts/migrateDeployWithRetry.js",
        "db:generate": "prisma generate",
        "db:studio": "prisma studio",
        "db:push": "prisma db push",
        "scripts:split-sds": "npx ts-node -r dotenv/config scripts/splitSds.ts",
        "scripts:ingest-docs": "npx ts-node -r dotenv/config scripts/ingestExistingDocs.ts",
        "scripts:import-toolbox-topics": "npx ts-node -r dotenv/config src/scripts/importToolboxTopics.ts",
        "scripts:backfill-quality-findings": "npx ts-node -r dotenv/config scripts/backfill-quality-findings-pdf.ts",
        "scripts:cleanup-logo-invoices": "npx ts-node scripts/cleanup-logo-invoices.ts",
        "scripts:resync-incoming-invoices": "npx ts-node scripts/resync-incoming-invoices.ts",
        "ci:build": "npm ci && npm run db:generate && npm run build",
        "postinstall": "prisma generate"
    },
    "dependencies": {
        "@anthropic-ai/sdk": "^0.78.0",
        "@azure/ai-form-recognizer": "^5.1.0",
        "@azure/identity": "^4.13.0",
        "@azure/storage-blob": "^12.31.0",
        "@composio/core": "^0.6.6",
        "@prisma/client": "^5.x",
        "bcryptjs": "^2.4.3",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "date-holidays": "^3.27.0",
        "dompurify": "^3.0.6",
        "dotenv": "^16.4.5",
        "express": "^4.19.2",
        "express-rate-limit": "^7.2.0",
        "googleapis": "^144.0.0",
        "helmet": "^7.1.0",
        "jsdom": "^24.0.0",
        "jsonwebtoken": "^9.0.2",
        "multer": "^1.4.5-lts.1",
        "nanoid": "^3.3.11",
        "nodemailer": "^8.0.1",
        "pdf-lib": "^1.17.1",
        "pdf-parse": "1.1.1",
        "pgvector": "^0.2.0",
        "prisma": "^5.22.0",
        "uuid": "^9.0.1",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.17",
        "@types/dompurify": "^3.2.0",
        "@types/express": "^4.17.21",
        "@types/jsdom": "^28.0.0",
        "@types/jsonwebtoken": "^9.0.6",
        "@types/multer": "^1.4.11",
        "@types/node": "^20.x",
        "@types/nodemailer": "^7.0.11",
        "@types/pdf-parse": "^1.1.5",
        "@types/uuid": "^9.0.8",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.9.3"
    }
}
