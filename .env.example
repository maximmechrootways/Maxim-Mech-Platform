# Copy to .env and adjust as needed, then run: docker compose up --build

POSTGRES_USER=maxim
POSTGRES_PASSWORD=maxim
POSTGRES_DB=maxim
POSTGRES_PORT=5432

BACKEND_PORT=3000
FRONTEND_PORT=5173

JWT_SECRET=dev-jwt-secret-change-me
JWT_REFRESH_SECRET=dev-jwt-refresh-secret-change-me
FRONTEND_URL=http://localhost:5173
SEED_DEMO_USERS=true
MAX_FILE_SIZE_MB=50

# TOTP 2FA (Authenticator apps). Keep enforcement false until TOTP_ENCRYPTION_KEY is set in each env.
TWO_FACTOR_ENFORCEMENT=false
# 32-byte key as 64 hex chars (openssl rand -hex 32) — required when TWO_FACTOR_ENFORCEMENT=true
TOTP_ENCRYPTION_KEY=
TOTP_ISSUER=Maxim Mechanical

# Optional integrations (leave blank for local UI/API without AI / email)
# ANTHROPIC_API_KEY=
# COMPOSIO_API_KEY=
# VOYAGE_API_KEY=
# EXTRA_ALLOWED_ORIGINS=
