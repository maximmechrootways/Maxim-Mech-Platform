{
  "name": "maxim-local-archive",
  "version": "1.1.1",
  "private": true,
  "description": "Maxim Local Archive Studio — USB intake + archive map for the GX10",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5179 && electron .\"",
    "build": "vite build",
    "start": "electron .",
    "pack": "npm run build && electron-builder --win portable"
  },
  "build": {
    "appId": "com.maximmech.localarchive",
    "productName": "Maxim Local Archive",
    "directories": {
      "output": "dist-installer"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "Maxim-Local-Archive-${version}.exe",
      "signAndEditExecutable": false
    }
  },
  "dependencies": {
    "force-graph": "^1.49.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  }
}
