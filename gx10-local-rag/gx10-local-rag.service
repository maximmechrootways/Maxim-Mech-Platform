[Unit]
Description=Maxim GX10 local RAG stack (API + Cloudflare tunnel) 24/7
Documentation=file:///home/maximmech/gx10-local-rag/README.md
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=maximmech
Group=maximmech
WorkingDirectory=/home/maximmech/gx10-local-rag
Environment=COMPOSE_PROJECT_NAME=gx10-local-rag
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose stop
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
