# Copy to .env on the GX10 and fill in.

# Postgres password for the local vector DB (internal only, pick anything strong)
POSTGRES_PASSWORD=

# Shared secret between the Maxim backend and this box.
# The same value goes into the Maxim backend's GX10_API_KEY env var.
# Generate with: openssl rand -hex 32
GX10_API_KEY=

# Optional short code for the LAN browser drop-box at http://192.168.1.198:8080
# (desktop app and Maxim backend use GX10_API_KEY instead)
UPLOAD_PASSCODE=

# Password for the SMB share (\\192.168.1.198\inbox, user "maxim")
SAMBA_PASSWORD=

# Cloudflare Tunnel token (Zero Trust dashboard -> Networks -> Tunnels -> create -> Docker token)
CLOUDFLARE_TUNNEL_TOKEN=

# Where documents live on the GX10 disk (inbox/, library/ created automatically)
DATA_DIR=/srv/local-rag

# Embedding model served by Ollama. bge-m3 = 1024 dims. If you change the model,
# update EMBED_DIMENSIONS and the vector(1024) columns in schema.sql to match.
EMBED_MODEL=bge-m3
EMBED_DIMENSIONS=1024
